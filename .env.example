# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas (cluster in Singapore or Mumbai)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/modz-tech?retryWrites=true&w=majority

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram order and contact alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Modz Tech <orders@example.com>"

# Analytics
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
